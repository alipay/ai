    "flows": [
      "AGGREGATE_CASHIER",
      "BANK_TRANSFER",
      "ENTERPRISE_EBANK"
    ],
    "capabilities": [
      "ACCOUNT_MANAGEMENT",
      "EBANK_CONSULT",
      "BANK_FUND_CONFIRMATION",
      "TRADE_CLOSE",
      "REFUND",
